# OpenTofu / Terraform — state contains the API token and server details.
fleet/providers/*/.terraform/
fleet/providers/*/.terraform.lock.hcl
fleet/providers/*/terraform.tfstate
fleet/providers/*/terraform.tfstate.backup
fleet/providers/*/*.tfplan
fleet/providers/*/*.plan
fleet/providers/*/tfplan
fleet/providers/*/crash*.log
fleet/providers/*/*.tfvars
fleet/providers/*/*.tfvars.json
# The tracked examples document every setting the real files must supply.
!fleet/providers/*/*.example.tfvars
!fleet/providers/*/*.example.tfvars.json

# Fleet — hand-made machines and their first-run addresses.
fleet/providers/manual/hosts.yml

# Ansible
ansible/*.retry
ansible/inventory/hosts.yml

# Python env (uv) and local secrets
.venv/
.env

docs
